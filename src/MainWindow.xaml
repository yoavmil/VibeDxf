<Window x:Class="VibeDxf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:VibeDxf" xmlns:dxf="clr-namespace:VibeDxf.Wpf;assembly=VibeDxf.Wpf"
 Icon="/Assets/VibeDxf.ico" Title="VibeDxf" Width="1280" Height="850" MinWidth="760" MinHeight="480"
 Background="#111820" Foreground="#DCE5EF" AllowDrop="True" Drop="FileDropped" DragOver="FileDragOver">
 <Window.Resources>
  <Style x:Key="StrategyToggle" TargetType="ToggleButton">
   <Setter Property="Content" Value="Closest"/>
   <Setter Property="MinWidth" Value="78"/>
   <Setter Property="Padding" Value="10,5"/>
   <Setter Property="Background" Value="#CBD7E3"/>
   <Setter Property="Foreground" Value="#18212B"/>
   <Setter Property="ToolTip" Value="Click to switch Center / Closest. Applies only to circles and arcs."/>
   <Style.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="Center"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="LayoutTab" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="16,5"/>
   <Setter Property="Margin" Value="0,0,2,0"/>
   <Setter Property="Foreground" Value="#DCE5EF"/>
   <Setter Property="Background" Value="#202C39"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2C3B4B"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#CBD7E3"/><Setter Property="Foreground" Value="#18212B"/></Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top" Background="#CBD7E3" Foreground="#18212B" Padding="8,5">
   <MenuItem Header="_File"><MenuItem Header="_Open DXF…" InputGestureText="Ctrl+O" Click="OpenClicked"/></MenuItem>
   <MenuItem Header="_View"><MenuItem x:Name="PanelMenu" Header="_Layers panel" IsCheckable="True" InputGestureText="Ctrl+L" Click="PanelMenuClicked"/></MenuItem>
  </Menu>
  <Border DockPanel.Dock="Bottom" Background="#202C39" Padding="14,9">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0">
     <TextBlock x:Name="Measurement" FontSize="16" Foreground="#58D7C1" TextWrapping="Wrap" Text="Select two elements to measure their distance."/>
     <TextBlock x:Name="Status" Margin="0,5,0,0" TextWrapping="Wrap" Text="Open or drop a DXF file.  •  Wheel: zoom  •  Middle/right drag: pan  •  F: fit  •  Esc: clear selection"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
     <StackPanel Margin="0,0,10,0">
      <TextBlock Text="1 · Orange" Foreground="Orange" Margin="0,0,0,4"/>
      <ToggleButton x:Name="FirstStrategyToggle" Style="{StaticResource StrategyToggle}" IsChecked="False"
       AutomationProperties.Name="First measurement strategy" Checked="StrategyChanged" Unchecked="StrategyChanged"/>
     </StackPanel>
     <StackPanel>
      <TextBlock Text="2 · Blue" Foreground="DeepSkyBlue" Margin="0,0,0,4"/>
      <ToggleButton x:Name="SecondStrategyToggle" Style="{StaticResource StrategyToggle}" IsChecked="False"
       AutomationProperties.Name="Second measurement strategy" Checked="StrategyChanged" Unchecked="StrategyChanged"/>
     </StackPanel>
    </StackPanel>
   </Grid>
  </Border>
  <!-- AutoCAD-style sheet tabs: Model plus one tab per paper layout. Hidden for drawings without layouts. -->
  <ListBox x:Name="LayoutTabs" DockPanel.Dock="Bottom" Visibility="Collapsed" SelectionChanged="LayoutTabChanged"
   Background="#18212B" BorderThickness="0" Padding="8,3" ItemContainerStyle="{StaticResource LayoutTab}"
   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
   AutomationProperties.Name="Model and layout tabs">
   <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
  </ListBox>
  <!-- The panel sits beside the swap-chain HwndHost, never over it (WPF cannot draw over a child HWND). -->
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="PanelColumn" Width="0"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <local:LayerPanel x:Name="Layers"/>
   <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#0D1218" Visibility="Collapsed"/>
   <dxf:DxfView x:Name="Viewer" Grid.Column="2"/>
  </Grid>
 </DockPanel>
</Window>
