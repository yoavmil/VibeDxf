<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
  <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  <IsPackable>true</IsPackable><Version>0.3.0</Version>
  <PackageId>VibeDxf.Wpf</PackageId><Authors>Yoav Miller and contributors</Authors>
  <Description>Embeddable Windows/WPF DXF viewer with prepared text geometry, document traversal, layer controls and double-precision distance measurement.</Description>
  <PackageTags>DXF;CAD;WPF;viewer;geometry;measurement</PackageTags>
  <PackageProjectUrl>https://github.com/yoavmil/VibeDxf</PackageProjectUrl>
  <RepositoryUrl>https://github.com/yoavmil/VibeDxf</RepositoryUrl><RepositoryType>git</RepositoryType>
  <PackageLicenseExpression>MIT</PackageLicenseExpression><PackageReadmeFile>README.md</PackageReadmeFile>
  <Copyright>Copyright (c) 2026 Yoav Miller and contributors</Copyright>
  <PackageReleaseNotes>Saved model-space VPORT and named VIEW cameras, perspective and depth clipping, and GPU depth display. Adds legacy 3D polylines/polyface meshes, MESH wireframes, straight/elliptical and explicit spline ACIS solid boundaries, tolerant topology, and complete untrimmed ring-torus surface display. All 13 Waschbecken sample solids load as boundary wireframes. Nonplan/perspective views are display-only; measurements remain projected XY. Requires Windows and .NET 10 Desktop Runtime. General trimmed surface shading, editing and DXF writing remain unsupported.</PackageReleaseNotes>
  <GenerateDocumentationFile>true</GenerateDocumentationFile>
 </PropertyGroup>
 <ItemGroup>
  <None Update="README.md" Pack="true" PackagePath="/"/>
  <None Include="../../LICENSE" Pack="true" PackagePath="/"/>
  <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/"/>
 </ItemGroup>
 <ItemGroup><PackageReference Include="Vortice.Direct3D11" Version="3.8.3"/><PackageReference Include="Vortice.Direct2D1" Version="3.8.3"/><PackageReference Include="Vortice.D3DCompiler" Version="3.8.3"/></ItemGroup>
</Project>
