<UserControl x:Class="VibeDxf.LayerPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#18212B" Foreground="#DCE5EF">
 <UserControl.Resources>
  <Style x:Key="PanelButton" TargetType="Button">
   <Setter Property="Padding" Value="8,2"/>
   <Setter Property="Margin" Value="0,0,4,4"/>
   <Setter Property="Background" Value="#CBD7E3"/>
   <Setter Property="Foreground" Value="#18212B"/>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>
 </UserControl.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="10,8,10,4">
   <TextBlock x:Name="Header" Style="{StaticResource Heading}" Text="Layers"/>
   <!-- Shown when hidden layers contain drawing content, so a drawing saved with layers off doesn't look broken. -->
   <Border x:Name="Banner" Background="#3A2F12" Padding="8,6" Margin="0,2,0,6" CornerRadius="3" Visibility="Collapsed">
    <StackPanel>
     <TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="#F5D27A"/>
     <Button Content="Show all" Click="ShowAllClicked" HorizontalAlignment="Left" Margin="0,6,0,0" Style="{StaticResource PanelButton}"/>
    </StackPanel>
   </Border>
   <TextBox x:Name="Search" TextChanged="SearchChanged" Padding="2" ToolTip="Filter layers by name"
    AutomationProperties.Name="Filter layers"/>
   <WrapPanel Margin="0,6,0,0">
    <Button Content="All on" Click="AllOnClicked" Style="{StaticResource PanelButton}"/>
    <Button Content="All off" Click="AllOffClicked" Style="{StaticResource PanelButton}"/>
    <Button Content="File state" Click="FileStateClicked" Style="{StaticResource PanelButton}"
     ToolTip="Restore the on/off/frozen layer state saved in the drawing"/>
   </WrapPanel>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="10,6,10,10">
   <TextBlock Text="Annotations" Style="{StaticResource Heading}"/>
   <ItemsControl x:Name="Categories">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <CheckBox IsChecked="{Binding Visible}" IsEnabled="{Binding HasItems}" Margin="0,2" Foreground="#DCE5EF">
       <TextBlock><Run Text="{Binding Label, Mode=OneWay}"/><Run Text="{Binding CountText, Mode=OneWay}" Foreground="#8A99A8"/></TextBlock>
      </CheckBox>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="Display" Style="{StaticResource Heading}" Margin="0,10,0,4"/>
   <CheckBox x:Name="MonochromeBox" Content="Monochrome" Foreground="#DCE5EF" Checked="MonochromeChanged" Unchecked="MonochromeChanged"
    ToolTip="Draw everything in one color instead of the drawing's layer and entity colors"/>
  </StackPanel>
  <ListBox x:Name="LayerList" Background="Transparent" BorderThickness="0" Margin="4,0" MouseDoubleClick="LayerDoubleClicked"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Layers"
   ToolTip="Double-click a layer to show only that layer">
   <ListBox.ItemTemplate>
    <DataTemplate>
     <Grid Margin="0,1">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <CheckBox IsChecked="{Binding Visible}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
      <Border Grid.Column="1" Width="12" Height="12" Margin="4,0,6,0" Background="{Binding Swatch}" BorderBrush="#5A6878" BorderThickness="1" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="2" VerticalAlignment="Center">
       <TextBlock Text="{Binding Name}" Foreground="#DCE5EF" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Badges}" Foreground="#C9A35A" FontSize="10" Visibility="{Binding BadgeVisibility}"/>
      </StackPanel>
      <TextBlock Grid.Column="3" Text="{Binding Count}" Foreground="#8A99A8" Margin="6,0,2,0" VerticalAlignment="Center"/>
     </Grid>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
 </DockPanel>
</UserControl>
