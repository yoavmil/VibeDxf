<Window x:Class="PackageViewer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:dxf="clr-namespace:VibeDxf.Wpf;assembly=VibeDxf.Wpf"
 Title="DXF package sample" Width="1100" Height="750">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
   <Button Content="Open DXF…" Click="OpenClicked" Padding="10,4" />
   <Button Content="Fit" Click="FitClicked" Padding="10,4" Margin="6,0" />
   <Button Content="Show all layers" Click="ShowAllClicked" Padding="10,4" />
   <CheckBox x:Name="Monochrome" Content="Monochrome" Checked="MonochromeChanged" Unchecked="MonochromeChanged" VerticalAlignment="Center" Margin="12,0" />
   <ComboBox x:Name="Layouts" Width="180" DisplayMemberPath="Name" SelectionChanged="LayoutChanged" />
  </StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="8" TextWrapping="Wrap" Text="Open a DXF, then select two elements to measure." />
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="Layers" FontWeight="Bold" Margin="0,0,0,6" />
     <ItemsControl x:Name="LayerList" Margin="0,0,0,12">
      <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}" /></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <Button Content="Measure two selected rows" Click="MeasureRowsClicked" Margin="0,0,0,8" />
     <TextBlock Text="Entities in the active space" FontWeight="Bold" />
    </StackPanel>
    <ListBox x:Name="Entities" SelectionMode="Extended" DisplayMemberPath="Description" />
   </DockPanel>
   <dxf:DxfView x:Name="Viewer" Grid.Column="1" />
  </Grid>
 </DockPanel>
</Window>
